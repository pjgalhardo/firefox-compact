{
  "manifest_version": 3,
  "name": "Compact Comfort",
  "version": "0.4.10",
  "description": "A local fork of Firefox Compact with a centred address editor, shared toolbar/sidebar reveal, and adjustable hover areas.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{7c23858c-b542-486c-aa0f-06bbae3c43fb}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Compact Comfort",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "commands": {
    "toggle-compact-mode": {
      "suggested_key": {
        "default": "Ctrl+Alt+C",
        "mac": "MacCtrl+Alt+C"
      },
      "description": "Turn compact mode on or off"
    }
  }
}
